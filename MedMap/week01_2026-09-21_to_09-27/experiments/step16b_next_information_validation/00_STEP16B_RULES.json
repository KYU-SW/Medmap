  "k": [
   3,
   5,
   10
  ],
  "initial": "INITIAL_EVIDENCE revealed first and excluded from k draws",
  "sampling": "uniform over currently eligible safe questions, sequential, no repeat",
  "rng_key": "(SPLIT_ID, seed, row_index)",
  "SPLIT_ID": {
   "step16b_train": 11,
   "step16b_holdout": 12
