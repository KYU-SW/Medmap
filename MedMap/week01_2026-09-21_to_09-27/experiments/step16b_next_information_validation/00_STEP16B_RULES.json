  "max_iter": 300,
  "random_state": 42,
  "per_k": true,
  "trained_on": "STEP16B_TRAIN only",
  "retrain_after_question": false,
  "reuse_step16a_models": false
 },
 "ig": {
  "alpha": 1.0,
  "log_base": 2,
  "estimated_on": "STEP16B_TRAIN only",
  "formula": "IG(q)=H(post)-sum_a P(a)H(post_a)",
  "tie": "ascending evidence id",
  "na_count_rule": "n_d - patients_with_token - parent_positive_missing; parent_positive_missing must be 0 for included questions"
 },
 "pools": {
  "SAFE_FULL_POOL": "unasked AND currently eligible (visible parent POS) AND not excluded",
  "SAFE_BINARY_POOL": "SAFE_FULL_POOL AND data_type==B",
  "identical_pool_for_random_and_ig": true,
  "disease_symptom_restriction": false
 },
