MEDMAP_STT_MODEL=turbo
# run_api.ps1 uses cuda/float16 when project-local NVIDIA libraries exist.
MEDMAP_STT_DEVICE=cuda
MEDMAP_STT_COMPUTE_TYPE=float16
MEDMAP_CACHE_DIR=../../local-cache
# Optional Whisper hint words: "medical" uses the built-in medical term list. Off unless set; not measured yet.
MEDMAP_STT_HOTWORDS=
